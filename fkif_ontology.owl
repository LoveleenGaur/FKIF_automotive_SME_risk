  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="rightshoulder" a="78" b="90" c="100" d="100"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

