<owl:NamedIndividual rdf:about="#Poor">
  <rdf:type rdf:resource="#FavourabilityTerm"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="leftshoulder" a="0" b="0" c="2.5" d="4.5"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Moderate">
  <rdf:type rdf:resource="#FavourabilityTerm"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="triangular" a="3.5" b="5.0" c="6.5"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Strong">
  <rdf:type rdf:resource="#FavourabilityTerm"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="rightshoulder" a="5.5" b="7.5" c="10" d="10"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

