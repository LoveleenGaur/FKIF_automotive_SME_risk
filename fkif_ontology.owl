<swrl:Variable rdf:about="urn:swrl#x"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#AutomotiveSME"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#hasTechnicalCapabilitySubRisk"/>
              <swrl:argument1 rdf:resource="urn:swrl#x"/>
              <swrl:argument2 rdf:resource="#HighSubRisk"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#hasOrganizationalCapacitySubRisk"/>
                  <swrl:argument1 rdf:resource="urn:swrl#x"/>
                  <swrl:argument2 rdf:resource="#HighSubRisk"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#hasSecurityAndComplianceSubRisk"/>
                      <swrl:argument1 rdf:resource="urn:swrl#x"/>
                      <swrl:argument2 rdf:resource="#HighSubRisk"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#hasEcosystemDependencySubRisk"/>
                          <swrl:argument1 rdf:resource="urn:swrl#x"/>
                          <swrl:argument2 rdf:resource="#HighSubRisk"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#hasRiskClass"/>
          <swrl:argument1 rdf:resource="urn:swrl#x"/>
          <swrl:argument2 rdf:resource="#CriticalRisk"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

