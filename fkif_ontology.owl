</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ModerateRisk">
  <rdf:type rdf:resource="#RiskClass"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="triangular" a="26" b="42" c="60"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
