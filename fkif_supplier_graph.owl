</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#ModerateRisk">
  <rdf:type rdf:resource="#RiskClass"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="triangular" a="26" b="42" c="60"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#HighRisk">
  <rdf:type rdf:resource="#RiskClass"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="triangular" a="52" b="68" c="84"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#CriticalRisk">
  <rdf:type rdf:resource="#RiskClass"/>
  <fuzzyLabel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">&lt;fuzzyOwl2 fuzzyType="datatype"&gt;&lt;Datatype type="rightshoulder" a="78" b="90" c="100" d="100"/&gt;&lt;/fuzzyOwl2&gt;</fuzzyLabel>
</owl:NamedIndividual>

